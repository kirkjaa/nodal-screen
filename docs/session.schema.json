{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nodal-screen/session@1",
  "type": "object",
  "required": ["schema", "provenance", "provenance_note", "participant", "visit", "qc", "tasks", "flags", "suggested_pathway"],
  "properties": {
    "schema": { "const": "nodal-screen/session@1" },
    "provenance": { "enum": ["synthetic", "simulated-m1", "measured"] },
    "provenance_note": { "type": "string", "minLength": 1 },
    "participant": {
      "type": "object",
      "required": ["pid", "group", "age_y", "sex"],
      "properties": {
        "pid": { "type": "string" },
        "group": { "enum": ["child", "adult"] },
        "age_y": { "type": "number" },
        "sex": { "enum": ["F", "M"] }
      }
    },
    "visit": { "type": "object" },
    "qc": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ok", "insufficient"] }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["metrics"],
        "properties": {
          "metrics": {
            "type": "array",
            "items": { "$ref": "#/$defs/metric" }
          },
          "curves": { "type": "object" }
        }
      }
    },
    "flags": {
      "type": "array",
      "items": { "$ref": "#/$defs/flag" }
    },
    "suggested_pathway": {
      "type": "object",
      "required": ["code"],
      "properties": {
        "code": {
          "enum": [
            "RECAPTURE",
            "WCV_DEV_REVIEW",
            "FALLS_PREVENTION",
            "ADULT_SARCOPENIA",
            "CLINICIAN_SPECIALIST",
            "ADULT_EARLY_REVIEW",
            "ROUTINE"
          ]
        },
        "reason_flag_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "review": { "type": ["object", "null"] },
    "history": { "type": "array" },
    "ai_texts": { "type": "object" }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["id", "side", "value", "unit", "ref", "cutoff", "status"],
      "properties": {
        "id": {
          "enum": [
            "gait_speed",
            "cadence",
            "stride_length",
            "stride_length_h",
            "step_time_cv",
            "double_support",
            "step_length_si",
            "step_time_si",
            "knee_rom",
            "heel_first_share",
            "tug_time",
            "sts5_time",
            "sls_time",
            "tandem_steps",
            "hop_count"
          ]
        },
        "side": { "enum": ["left", "right", null] },
        "value": { "type": ["number", "null"] },
        "unit": { "type": "string" },
        "ref": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["kind", "source_id", "mean", "sd", "z"],
              "properties": {
                "kind": { "const": "norm" },
                "source_id": { "type": "string" },
                "mean": { "type": ["number", "null"] },
                "sd": { "type": ["number", "null"] },
                "z": { "type": ["number", "null"] },
                "status": { "type": "string" }
              }
            }
          ]
        },
        "cutoff": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["source_id", "threshold", "op", "met"],
              "properties": {
                "source_id": { "type": "string" },
                "threshold": { "type": "number" },
                "op": { "enum": [">=", ">", "<=", "<"] },
                "met": { "type": "boolean" }
              }
            }
          ]
        },
        "status": {
          "enum": ["insufficient", "out_of_range", "borderline", "in_range", "no_reference"]
        }
      }
    },
    "flag": {
      "type": "object",
      "required": ["id", "rule", "severity", "metric_ids", "evidence", "confidence", "source_ids"],
      "properties": {
        "id": { "type": "string" },
        "rule": { "enum": ["norm_z", "cutoff", "asymmetry", "toe_walk", "change"] },
        "severity": { "enum": ["flag", "watch"] },
        "title": { "type": "string" },
        "metric_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": { "type": "string" },
        "confidence": { "type": "string" },
        "source_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
